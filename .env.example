# Local development: copy to .env (never commit .env) and change the values.
GROUP_CODE=change-group-code
ADMIN_CODE=change-admin-code
# A long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-to-a-long-random-string

# Optional: overrides `enabled` in config/info.yaml (true/false). Leave unset locally so the file decides.
# INFO_ENABLED=

# Production: put these in /etc/cabin/secrets.env (not in a .env next to compose.yaml):
#   GROUP_CODE, ADMIN_CODE, SECRET_KEY
#   INFO_ENABLED=true   (optional; without it the „Pred cestou“ section stays off)
