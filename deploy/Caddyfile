# Example Caddyfile. Replace the host name with your own (sub)domain whose DNS points to this server.
# Caddy gets and renews the HTTPS certificate by itself.
cabin.example.com {
	reverse_proxy 127.0.0.1:8010 {
		# Always set the real client IP yourself (overwrite, never append). The app (in Docker, port published
		# on 127.0.0.1 only, see compose.yaml) trusts this header and counts the wrong-code limit per IP.
		header_up X-Forwarded-For {remote_host}
	}
	# Live updates: /api/events is a long-lived text/event-stream response. Caddy flushes it at once, so no extra
	# setting is needed. If you ever add `encode` (compression), do not apply it to /api/events, because
	# compression buffers the stream and the pages would fall back to polling every 30 s:
	#   @notstream not path /api/events
	#   encode @notstream gzip
}

# The app uses relative API paths, so it can also live under a sub-path of a bigger site:
#
#   example.com {
#   	handle_path /cabin/* {
#   		reverse_proxy 127.0.0.1:8010 {
#   			header_up X-Forwarded-For {remote_host}
#   		}
#   	}
#   }
#
# (and open https://example.com/cabin/ with the trailing slash).
#
# nginx equivalent (HTTPS certificates, for example with certbot, are set up separately):
#
#   server {
#       listen 443 ssl;
#       server_name cabin.example.com;
#       # ssl_certificate / ssl_certificate_key ...
#       location / {
#           proxy_pass http://127.0.0.1:8010;
#           proxy_set_header Host $host;
#           proxy_set_header X-Forwarded-For $remote_addr;      # not $proxy_add_x_forwarded_for
#           proxy_set_header X-Forwarded-Proto $scheme;
#       }
#       # Live updates (event stream): no buffering, long read timeout, same headers as above.
#       location /api/events {
#           proxy_pass http://127.0.0.1:8010;
#           proxy_set_header Host $host;
#           proxy_set_header X-Forwarded-For $remote_addr;
#           proxy_set_header X-Forwarded-Proto $scheme;
#           proxy_buffering off;
#           proxy_read_timeout 1h;
#       }
#   }
